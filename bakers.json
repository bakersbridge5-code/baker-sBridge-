{% assign list = site.bakers | where_exp: "b", "b.consent == true" %}[{% for b in list %}{"id":"b{{ forloop.index }}","name":{{ b.title | jsonify }},"city":{{ b.city | jsonify }},"area":{{ b.area | jsonify }},"specs":{{ b.specs | jsonify }},"about":{{ b.about | jsonify }},"lead":{{ b.lead | jsonify }},"mode":{{ b.mode | jsonify }},"insta":{{ b.insta | jsonify }},"photo":{{ b.photo | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
