<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>My Workspace | Baker’s Bridge</title>
<link rel="icon" href="data:image/jpeg;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
<style>
:root{--c0:#0B0B0A;--c1:#151513;--iv:#F3EBDD;--gold:#C7A96B;--ol:#9A9B67;--gr:rgba(243,235,221,.62);--line:rgba(243,235,221,.14);--logo:url(data:image/jpeg;base64,)}
*{box-sizing:border-box;margin:0}[hidden]{display:none!important}
body{background:var(--c0);color:var(--iv);font:400 16px/1.6 Lato,"Helvetica Neue",Arial,sans-serif;min-height:100vh}
h1,h2,h3,.serif{font-family:"Playfair Display",Georgia,serif;font-weight:400}a{color:inherit;text-decoration:none}
.wrap{max-width:1000px;margin:0 auto;padding:0 20px}
nav{position:sticky;top:0;z-index:20;background:rgba(11,11,10,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;height:66px;max-width:1160px}
.logo{display:flex;align-items:center;gap:10px;font-size:23px}.logo i{color:var(--gold);font-style:normal}
.lg{flex:none;width:44px;height:44px;border-radius:50%;background:var(--logo) center/cover}
.nr{display:flex;align-items:center;gap:14px;font-size:14px;color:var(--gr)}.nr .btn{padding:9px 18px}
.btn{display:inline-block;border:0;cursor:pointer;background:var(--gold);color:var(--c0);padding:13px 24px;border-radius:999px;font:700 13px Lato,sans-serif;letter-spacing:.04em}
.btn.ghost{background:none;border:1px solid var(--gold);color:var(--gold)}.btn:hover:not(:disabled){background:var(--iv)}.btn.ghost:hover:not(:disabled){background:rgba(199,169,107,.12)}
.btn:disabled{opacity:.45;cursor:not-allowed}
main{padding:44px 0 80px}.card{background:var(--c1);border:1px solid var(--line);border-radius:22px;padding:30px 28px}
.auth{max-width:440px;margin:20px auto 0}.tabs{display:flex;gap:6px;margin-bottom:22px;border-bottom:1px solid var(--line)}
.tabs button{flex:1;background:none;border:0;border-bottom:2px solid transparent;color:var(--gr);padding:10px;font:700 14px Lato,sans-serif;cursor:pointer}.tabs button.on{color:var(--gold);border-color:var(--gold)}
label{display:block;font-size:13px;color:var(--gr);margin:14px 0 5px}
input,select{width:100%;background:var(--c0);border:1px solid var(--line);border-radius:12px;padding:12px 14px;color:var(--iv);font:inherit}input:focus,select:focus{outline:0;border-color:var(--gold)}
input[readonly]{opacity:.6}.chk{display:flex;gap:8px;align-items:flex-start;font-size:13px;color:var(--gr)}.chk input{width:auto;margin-top:4px}.chk a,.lnk{color:var(--gold);text-decoration:underline;background:none;border:0;font:inherit;cursor:pointer}
form .btn{width:100%;margin-top:20px}form .row{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}
.msg{min-height:20px;margin-top:12px;font-size:13px;color:#e8a5a5}.msg.ok{color:var(--ol)}.sub{font-size:13px;color:var(--gr);margin-top:14px;text-align:center}
h1{font-size:clamp(30px,5vw,44px);line-height:1.1;margin:8px 0}.eyebrow{color:var(--gold);font-size:12px;font-weight:700;letter-spacing:.3em;text-transform:uppercase}
.lead{color:var(--gr)}.dh{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:26px}
.stats,.two{display:grid;gap:16px;grid-template-columns:1fr 1fr}.st span{font:400 44px/1 "Playfair Display",serif;color:var(--gold)}.st p{color:var(--gr);font-size:14px;margin-top:6px}
.acts{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}.acts .btn{width:auto;margin:0}.acts small{display:block;font-size:10px;font-weight:400;letter-spacing:0;opacity:.8}
.two{margin-top:6px}.card h3{font-size:24px;margin-bottom:10px}.rl{list-style:none;padding:0;color:var(--gr);font-size:14px}.rl li{padding:8px 0;border-top:1px solid var(--line)}
.note{margin-top:26px;color:var(--gr);font-size:12px;text-align:center}footer{padding:26px 0;border-top:1px solid var(--line);color:var(--gr);font-size:13px;text-align:center}footer a{text-decoration:underline}
@media(max-width:640px){form .row,.stats,.two{grid-template-columns:1fr}.card{padding:24px 20px}.nr #who{display:none}.acts .btn{flex:1 1 calc(50% - 10px);padding:12px 10px}}
</style>
</head>
<body>
<nav><div class="wrap"><a href="/" class="logo"><span class="lg" aria-hidden="true"></span><span class="serif">Baker<i>’</i>s Bridge</span></a>
<div class="nr"><span id="who"></span><a href="/" class="lnk">← Website</a><button id="out" class="btn ghost" hidden>Log out</button></div></div></nav>
<main class="wrap">
<section id="loading"><p class="lead" style="text-align:center">Loading your workspace…</p></section>
<section id="auth" hidden><div class="card auth">
  <div style="text-align:center;margin-bottom:18px"><span class="eyebrow">My Workspace</span><h1>Your bakery, organised</h1></div>
  <div class="tabs"><button type="button" data-t="login" class="on">Log in</button><button type="button" data-t="signup">Create account</button></div>
  <form id="fLogin" data-pane="login"><label for="lemail">Email</label><input id="lemail" name="email" type="email" autocomplete="email" required><label for="lpass">Password</label><input id="lpass" name="password" type="password" autocomplete="current-password" required>
    <p class="msg" id="mLogin" role="alert"></p><button class="btn" type="submit">Log in</button><p class="sub"><button type="button" class="lnk" data-go="reset">Forgot password?</button></p></form>
  <form id="fSignup" data-pane="signup" hidden><label for="semail">Email</label><input id="semail" name="email" type="email" autocomplete="email" required><label for="spass">Password (at least 8 characters)</label><input id="spass" name="password" type="password" autocomplete="new-password" required minlength="8"><label for="sagain">Confirm password</label><input id="sagain" name="again" type="password" autocomplete="new-password" required>
    <label class="chk" style="margin-top:16px"><input type="checkbox" name="agree"> <span>I accept the <a href="/#terms">Terms</a> and <a href="/#privacy">Privacy Policy</a>.</span></label>
    <p class="msg" id="mSignup" role="alert"></p><button class="btn" type="submit">Create account</button></form>
  <form id="fReset" data-pane="reset" hidden><label for="remail">Email</label><input id="remail" name="email" type="email" autocomplete="email" required>
    <p class="msg" id="mReset" role="alert"></p><button class="btn" type="submit">Send reset link</button><p class="sub"><button type="button" class="lnk" data-go="login">Back to log in</button></p></form>
</div></section>
<section id="setup" hidden><div class="card" style="max-width:640px;margin:0 auto"><span class="eyebrow">My Workspace</span><h1 id="sTitle">Set up your business profile</h1>
  <form id="fSetup"><div class="row"><div><label for="fullName">Full name</label><input id="fullName" name="fullName" type="text" maxlength="100" required></div><div><label for="businessName">Business name</label><input id="businessName" name="businessName" type="text" maxlength="120" required></div></div>
  <div class="row"><div><label for="businessType">Business type</label><select id="businessType" name="businessType"></select></div><div><label for="stage">Business stage</label><select id="stage" name="stage"></select></div></div>
  <div class="row"><div><label for="email">Email</label><input id="email" name="email" type="email" readonly></div><div><label for="phone">Phone number (optional)</label><input id="phone" name="phone" type="tel" maxlength="20" autocomplete="tel"></div></div>
  <div class="row"><div><label for="city">City</label><input id="city" name="city" type="text" maxlength="80"></div><div><label for="state">State</label><input id="state" name="state" type="text" maxlength="80"></div></div>
  <div class="row"><div><label for="currency">Preferred currency</label><select id="currency" name="currency"><option value="INR">INR (₹)</option><option value="USD">USD ($)</option><option value="AED">AED</option></select></div><div><label for="units">Measurement units</label><select id="units" name="units" disabled><option>Metric (g, kg, ml, l)</option></select></div></div>
  <p class="msg" id="mSetup" role="alert"></p><button class="btn" type="submit">Save and continue</button><button class="btn ghost" type="button" id="sCancel" hidden>Cancel</button></form></div></section>
<section id="dash" hidden>
  <div class="dh"><div><span class="eyebrow">My Workspace</span><h1 id="dHi"></h1><p class="lead" id="dBiz"></p></div><button id="dEdit" class="btn ghost" type="button" style="width:auto;margin:0">Edit profile</button></div>
  <div class="stats"><div class="card st"><span id="nRec">–</span><p>Saved recipes</p></div><div class="card st"><span id="nIng">–</span><p>Ingredients</p></div></div>
  <div class="acts"><button class="btn" disabled title="Coming in the next update">Create recipe<small>Coming soon</small></button><button class="btn" disabled title="Coming in the next update">Add ingredient<small>Coming soon</small></button><button class="btn" disabled title="Coming in the next update">Add purchase<small>Coming soon</small></button><button class="btn" disabled title="Coming in the next update">My notes<small>Coming soon</small></button></div>
  <div class="two"><div class="card"><h3>Recent purchases</h3><ul class="rl" id="lPur"></ul></div><div class="card"><h3>Recent costing</h3><ul class="rl" id="lCost"></ul></div></div>
  <p class="note">Costing, tax and profit figures in My Workspace are estimates based on what you enter. Please verify them, and check tax treatment with your accountant.</p>
</section>
<section id="err" hidden><div class="card" style="max-width:520px;margin:0 auto;text-align:center"><h3>We couldn’t open your workspace</h3><p class="lead" id="errMsg" style="margin:8px 0 18px"></p><button class="btn" id="retry" type="button" style="width:auto">Try again</button> <button class="btn ghost" id="eOut" type="button" style="width:auto;margin-top:0">Log out</button></div></section>
</main>
<footer><div class="wrap"><a href="/#privacy">Privacy Policy</a> · <a href="/#terms">Terms &amp; Conditions</a> · © 2026 Baker’s Bridge</div></footer>
<script src="app.js" defer></script>
</body>
</html>
